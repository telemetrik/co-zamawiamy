# Neon: Connect -> Connection string -> Connection pooling.
# Tylko po stronie serwera. Nie dodawaj prefiksu NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Opcjonalne: osobna, bezpośrednia connection string do migracji.
# Jeśli brak, migracje korzystają z DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Wyłącznie do testów integracyjnych: osobna baza lub branch testowy Neon.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-TEST-ENDPOINT-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
